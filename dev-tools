import React, { useCallback, useEffect, useState } from 'react';
import {
  Server,
  Database,
  Cloud,
  Lock,
  Terminal,
  Activity,
  ToggleLeft,
  ToggleRight,
  CheckCircle,
} from 'lucide-react';

const MAX_LOGS = 5;

const codeSnippets = {
  local: {
    auth: `import { connectAuthEmulator, getAuth } from "firebase/auth";
import { getApp } from "firebase/app";

const app = getApp();
const auth = getAuth(app);
connectAuthEmulator(auth, "http://127.0.0.1:9099");`,

    firestore: `import { connectFirestoreEmulator, getFirestore } from "firebase/firestore";
import { getApp } from "firebase/app";

const app = getApp();
const db = getFirestore(app);
connectFirestoreEmulator(db, "127.0.0.1", 8080);`,

    functions: `import { connectFunctionsEmulator, getFunctions } from "firebase/functions";
import { getApp } from "firebase/app";

const app = getApp();
const functions = getFunctions(app);
connectFunctionsEmulator(functions, "127.0.0.1", 5001);`,

    iam: `// O Emulator Suite não aplica IAM do GCP.
// Para testes locais, use Application Default Credentials apenas
// quando integrar serviços reais, por exemplo:
// gcloud auth application-default login`,
  },

  production: {
    auth: `import { getAuth } from "firebase/auth";
import { getApp } from "firebase/app";

const app = getApp();
const auth = getAuth(app);
// O Firebase Auth de produção usa o backend do Firebase/Identity Platform.`,

    firestore: `import { getFirestore } from "firebase/firestore";
import { getApp } from "firebase/app";

const app = getApp();
const db = getFirestore(app);
// O acesso é controlado pelas Firebase Security Rules;
// permissões de backend são controladas por IAM/Service Accounts.`,

    functions: `import { getFunctions } from "firebase/functions";
import { getApp } from "firebase/app";

const app = getApp();
const functions = getFunctions(app, "us-central1");`,

    iam: `// Aplique o princípio do menor privilégio às Service Accounts.
// Evite papéis amplos como Editor/Owner em produção.
// Use Secret Manager para credenciais e configurações sensíveis.`,
  },
};

function createLogId() {
  if (typeof crypto !== 'undefined' && crypto.randomUUID) {
    return crypto.randomUUID();
  }
  return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
}

export default function GcpFirebasePedagogy() {
  const [environment, setEnvironment] = useState('local');
  const [logs, setLogs] = useState([]);

  const addLog = useCallback((message) => {
    const timestamp = new Date().toISOString().split('T')[1].slice(0, 8);

    setLogs((previousLogs) => [
      ...previousLogs.slice(-(MAX_LOGS - 1)),
      {
        id: createLogId(),
        timestamp,
        message,
      },
    ]);
  }, []);

  useEffect(() => {
    addLog(`System initialized. Current target: ${environment.toUpperCase()}`);

    const connectionTimer = setTimeout(() => {
      addLog(
        environment === 'local'
          ? 'Connecting to Firebase Emulator Suite via 127.0.0.1...'
          : 'Connecting to Firebase/GCP production services...'
      );
    }, 600);

    return () => {
      clearTimeout(connectionTimer);
    };
  }, [environment, addLog]);

  const toggleEnvironment = () => {
    setEnvironment((currentEnvironment) =>
      currentEnvironment === 'local' ? 'production' : 'local'
    );
  };

  const isLocal = environment === 'local';

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 p-8 font-sans selection:bg-blue-500 selection:text-white">
      <div className="max-w-6xl mx-auto space-y-8">
        <header className="flex justify-between items-end border-b border-slate-700 pb-6">
          <div>
            <h1 className="text-3xl font-bold bg-gradient-to-r from-blue-400 to-amber-500 bg-clip-text text-transparent">
              GCP/Firebase Architecture Enablement
            </h1>

            <p className="text-slate-400 mt-2">
              Interactive configuration pedagogy for enterprise deployments
            </p>
          </div>

          <div className="flex items-center space-x-4 bg-slate-800 p-3 rounded-lg border border-slate-700">
            <span
              className={`text-sm font-semibold ${
                isLocal ? 'text-amber-400' : 'text-slate-500'
              }`}
            >
              Local Emulator
            </span>

            <button
              type="button"
              onClick={toggleEnvironment}
              className="text-blue-500 hover:text-blue-400 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
              role="switch"
              aria-checked={!isLocal}
              aria-label={`Toggle environment. Current environment: ${
                isLocal ? 'Local Emulator' : 'Production GCP'
              }`}
            >
              {isLocal ? <ToggleLeft size={36} /> : <ToggleRight size={36} />}
            </button>

            <span
              className={`text-sm font-semibold ${
                !isLocal ? 'text-blue-400' : 'text-slate-500'
              }`}
            >
              Production GCP
            </span>
          </div>
        </header>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
          <section className="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-lg relative overflow-hidden group">
            <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
              <Lock size={100} />
            </div>

            <div className="flex items-center space-x-3 mb-4">
              <Lock className="text-amber-500" />
              <h2 className="text-xl font-semibold">Identity &amp; Access</h2>
            </div>

            <p className="text-sm text-slate-400 mb-4 h-10">
              {isLocal
                ? 'Auth Emulator intercepts Firebase Auth requests. No live phone/email verification is required.'
                : 'Live Firebase Auth. Backend permissions are enforced by GCP IAM and Service Accounts.'}
            </p>

            <div className="bg-slate-950 p-4 rounded-md font-mono text-sm text-green-400 overflow-x-auto">
              <pre>{codeSnippets[environment].auth}</pre>
            </div>

            <div className="mt-4 bg-slate-950 p-4 rounded-md font-mono text-sm text-purple-400 overflow-x-auto">
              <pre>{codeSnippets[environment].iam}</pre>
            </div>
          </section>

          <section className="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-lg relative overflow-hidden group">
            <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
              <Database size={100} />
            </div>

            <div className="flex items-center space-x-3 mb-4">
              <Database className="text-blue-500" />
              <h2 className="text-xl font-semibold">Firestore NoSQL</h2>
            </div>

            <p className="text-sm text-slate-400 mb-4 h-10">
              {isLocal
                ? 'Local Firestore Emulator. Security Rules can be validated locally. Data is not persisted unless explicitly exported.'
                : 'Firestore database protected by Firebase Security Rules. Replication depends on the configured database location.'}
            </p>

            <div className="bg-slate-950 p-4 rounded-md font-mono text-sm text-green-400 overflow-x-auto">
              <pre>{codeSnippets[environment].firestore}</pre>
            </div>

            <div className="mt-4 flex items-center space-x-2 text-sm text-slate-300">
              <CheckCircle size={16} className="text-green-500" />
              <span>
                Rules validation:{' '}
                {isLocal ? 'Local emulator and unit tests' : 'Deployed .rules file'}
              </span>
            </div>
          </section>

          <section className="bg-slate-800 rounded-xl p-6 border border-slate-700 shadow-lg relative overflow-hidden group md:col-span-2">
            <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
              <Cloud size={100} />
            </div>

            <div className="flex items-center space-x-3 mb-4">
              <Server className="text-emerald-500" />
              <h2 className="text-xl font-semibold">Functions v2 &amp; Cloud Run</h2>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <p className="text-sm text-slate-400 mb-4">
                  {isLocal
                    ? 'Functions Emulator binds to port 5001. Hot reloading supports rapid iteration.'
                    : 'Deployed to Cloud Run. Configure concurrency, memory, timeouts and ingress according to workload requirements.'}
                </p>

                <div className="bg-slate-950 p-4 rounded-md font-mono text-sm text-green-400 overflow-x-auto">
                  <pre>{codeSnippets[environment].functions}</pre>
                </div>
              </div>

              <div className="bg-slate-700/50 p-4 rounded-lg border border-slate-600">
                <h3 className="font-semibold text-slate-200 mb-2">
                  Service Integrations
                </h3>

                <ul className="space-y-2 text-sm text-slate-400">
                  <li className="flex justify-between">
                    <span>Cloud Tasks</span>
                    <span
                      className={
                        isLocal ? 'text-amber-500' : 'text-blue-400'
                      }
                    >
                      {isLocal ? 'Mocked/Inline' : 'GCP-managed queue'}
                    </span>
                  </li>

                  <li className="flex justify-between">
                    <span>Secret Manager</span>
                    <span
                      className={
                        isLocal ? 'text-amber-500' : 'text-blue-400'
                      }
                    >
                      {isLocal ? '.env.local' : 'Runtime bindings'}
                    </span>
                  </li>

                  <li className="flex justify-between">
                    <span>Cloud Storage</span>
                    <span
                      className={
                        isLocal ? 'text-amber-500' : 'text-blue-400'
                      }
                    >
                      {isLocal ? 'Local Storage Emulator' : 'Cloud Storage buckets'}
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </section>
        </div>

        <div className="bg-slate-950 rounded-xl p-4 border border-slate-800 shadow-inner">
          <div className="flex items-center space-x-2 mb-3 text-slate-500 border-b border-slate-800 pb-2">
            <Terminal size={16} />
            <span className="text-xs font-mono uppercase tracking-wider">
              System Event Log
            </span>
            <div className="flex-1" />
            <Activity size={16} className="animate-pulse text-green-500" />
          </div>

          <div className="font-mono text-sm text-slate-300 space-y-1">
            {logs.map((log) => (
              <div key={log.id} className="animate-fade-in">
                [{log.timestamp}] {log.message}
              </div>
            ))}

            {logs.length === 0 && (
              <span className="text-slate-600">Waiting for events...</span>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
